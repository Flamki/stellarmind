{
  // markdownlint-cli2 configuration
  // Rule reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // Prettier already enforces line wrapping; keep code blocks, tables, and
    // URLs free-form instead of failing on long lines.
    "MD013": false,
    // Allow repeated headings across different sections (e.g. per-endpoint
    // "Examples" subsections in docs/API_EXAMPLES.md).
    "MD024": { "siblings_only": true },
    // Allow inline HTML (badges, <details>, tooltips, etc.).
    "MD033": false,
    // Allow both ``` and ```` fences so nested code samples can use
    // 4-backtick fences around content that itself contains ```.
    "MD046": { "style": "fenced" },
    // Prettier owns table formatting (aligned pipes/padding); don't double-enforce.
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".git/**", "coverage/**", "dist/**", ".github/**"]
}
